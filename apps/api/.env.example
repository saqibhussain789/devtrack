# Runtime environment: development | test | production
NODE_ENV=development

# Port the Express API listens on
PORT=4000

# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://devtrack:devtrack@localhost:5432/devtrack"

# Secrets used to sign access/refresh JWTs. Use distinct, long random values
# in every environment. Rotate immediately if either is ever exposed.
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# Domain the refresh-token cookie is scoped to. Leave unset for localhost.
# COOKIE_DOMAIN=devtrack.example.com

# Origin allowed to call the API with credentials (the web app's URL)
CORS_ORIGIN=http://localhost:3000

# Where the browser is redirected after auth flows that require a full page
# navigation (currently just GitHub OAuth login)
FRONTEND_URL=http://localhost:3000

# GitHub OAuth login (optional — "Continue with GitHub" is hidden if unset).
# Create an OAuth App at https://github.com/settings/developers with
# Authorization callback URL matching GITHUB_OAUTH_CALLBACK_URL below.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
